---
import { Icon } from 'astro-icon/components'
---

<footer class="border-t border-border-base">
  <div
    class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-4 px-6 py-10 sm:flex-row sm:items-center"
  >
    <p class="text-sm text-text-secondary">
      <span class="text-accent">$</span> el código es solo el principio.
    </p>

    <a
      href="https://github.com/Isabellopezmunoz/workshop-claude"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-sm text-text-secondary hover:text-accent transition"
    >
      <Icon name="lucide:github" class="size-4" />
      github
    </a>
  </div>
</footer>
