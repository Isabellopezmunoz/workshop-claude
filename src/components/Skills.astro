---
import { Icon } from 'astro-icon/components';

const tipos = [
  {
    nombre: 'Project skills',
    ubicacion: '.claude/skills/',
    descripcion:
      'Viven dentro del repo. Se versionan con git y las comparte todo el equipo. Útiles para convenciones del proyecto.',
    icono: 'lucide:folder-git-2',
  },
  {
    nombre: 'Personal skills',
    ubicacion: '~/.claude/skills/',
    descripcion:
      'Globales para tu usuario. Te siguen entre proyectos. Útiles para tus preferencias y flujos personales.',
    icono: 'lucide:user',
  },
  {
    nombre: 'Plugin skills',
    ubicacion: 'plugin:nombre-skill',
    descripcion:
      'Vienen empaquetadas dentro de plugins de Claude Code (ej. el plugin de Figma). Se invocan con prefijo.',
    icono: 'lucide:plug',
  },
];

const invocaciones = [
  {
    titulo: '/nombre-skill',
    descripcion: 'Invocación explícita escribiendo el nombre como un slash command.',
    icono: 'lucide:slash',
  },
  {
    titulo: 'Activación automática',
    descripcion: 'Claude lee el campo description de cada skill y la activa cuando detecta que el contexto encaja.',
    icono: 'lucide:zap',
  },
  {
    titulo: 'Composición',
    descripcion: 'Varias skills pueden estar activas a la vez si la tarea las requiere.',
    icono: 'lucide:layers',
  },
];
---

<section id="skills" class="border-b border-border-base">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <div class="max-w-3xl">
      <p class="mb-3 text-xs uppercase tracking-widest text-accent">// 01 — Skills</p>
      <h2 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">
        Skills
      </h2>
      <p class="mt-4 text-lg text-text-secondary">
        Una <strong class="text-text-primary">skill</strong> es un conjunto de instrucciones especializadas
        que le dice a Claude <em>cuándo</em> activarse y <em>cómo</em> trabajar en un dominio concreto.
        Encapsulan convenciones, evitan repetir contexto y mantienen consistencia entre sesiones.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tipos.map((tipo) => (
        <article class="border border-border-base bg-bg-raised p-6 hover:border-border-strong transition">
          <Icon name={tipo.icono} class="size-6 text-accent" />
          <h3 class="mt-4 text-base font-semibold text-text-primary">{tipo.nombre}</h3>
          <code class="mt-2 inline-block text-xs text-accent">{tipo.ubicacion}</code>
          <p class="mt-3 text-sm text-text-secondary leading-relaxed">{tipo.descripcion}</p>
        </article>
      ))}
    </div>

    <div class="mt-8 border border-border-base bg-bg-raised p-6 sm:p-8">
      <h3 class="text-base font-semibold text-text-primary">¿Cómo se invocan?</h3>
      <ul class="mt-5 grid gap-4 sm:grid-cols-3">
        {invocaciones.map((item) => (
          <li class="flex gap-3">
            <Icon name={item.icono} class="size-5 shrink-0 text-accent mt-0.5" />
            <div>
              <p class="text-sm font-semibold text-text-primary">{item.titulo}</p>
              <p class="mt-1 text-xs text-text-secondary leading-relaxed">{item.descripcion}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
