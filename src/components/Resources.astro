---
import { Icon } from 'astro-icon/components'

const recursos = [
  {
    titulo: 'Documentación oficial de Claude Code',
    url: 'https://docs.claude.com/en/docs/claude-code/overview',
    descripcion: 'La referencia principal: instalación, configuración, hooks, skills, MCP.',
  },
  {
    titulo: 'Anthropic API docs',
    url: 'https://docs.claude.com/en/api/overview',
    descripcion: 'Si quieres construir tus propias apps con Claude más allá del CLI.',
  },
  {
    titulo: 'Claude Agent SDK',
    url: 'https://docs.claude.com/en/api/agent-sdk/overview',
    descripcion: 'Para construir agentes personalizados sobre la misma base que usa Claude Code.',
  },
  {
    titulo: 'Repositorio de Claude Code',
    url: 'https://github.com/anthropics/claude-code',
    descripcion: 'Issues, releases y discusión de la comunidad.',
  },
]
---

<section id="recursos" class="border-b border-border-base">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <div class="max-w-3xl">
      <p class="mb-3 text-xs uppercase tracking-widest text-accent">// 03 — Recursos</p>
      <h2 class="text-3xl font-bold tracking-tight text-text-primary sm:text-4xl">Recursos</h2>
      <p class="mt-4 text-lg text-text-secondary">
        Enlaces para seguir aprendiendo cuando termines de cacharrear con esta landing.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        recursos.map((recurso) => (
          <a
            href={recurso.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group block border border-border-base bg-bg-raised p-6 hover:border-accent hover:bg-bg-hover transition"
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-base font-semibold text-text-primary group-hover:text-accent transition">
                {recurso.titulo}
              </h3>
              <Icon
                name="lucide:arrow-up-right"
                class="size-4 shrink-0 text-text-muted group-hover:text-accent transition"
              />
            </div>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed">{recurso.descripcion}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
