---
import { Icon } from 'astro-icon/components'

const links = [
  { label: 'Skills', href: '/docs/skills' },
  { label: 'Hooks', href: '/docs/hooks' },
  { label: 'Slash commands', href: '/docs/slash-commands' },
  { label: 'MCP', href: '/docs/mcp' },
  { label: 'Agentes', href: '/docs/agents' },
]

const currentPath = Astro.url.pathname
---

<header class="sticky top-0 z-50 border-b border-border-base bg-bg-base/80 backdrop-blur">
  <div class="flex items-center justify-between px-6 py-5 sm:px-10 lg:px-16">
    <a
      href="/"
      class="group inline-flex items-center gap-3 text-base font-semibold text-text-primary sm:text-lg"
    >
      <span
        class="inline-flex size-10 items-center justify-center border border-border-base bg-bg-raised text-accent group-hover:border-accent transition"
      >
        <Icon name="lucide:chevron-right" class="size-5" />
      </span>
      <span class="hidden sm:inline">
        <span class="text-text-muted">~/</span>workshop-claude
      </span>
      <span class="sm:hidden">
        <span class="text-text-muted">~/</span>wc
      </span>
    </a>

    <nav class="flex items-center gap-2 sm:gap-4">
      {
        links.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(link.href + '/')
          return (
            <a
              href={link.href}
              class:list={[
                'hidden px-3 py-2 text-sm uppercase tracking-widest transition sm:inline-block',
                isActive ? 'text-accent' : 'text-text-secondary hover:text-accent',
              ]}
            >
              {link.label}
            </a>
          )
        })
      }

      <a
        href="https://github.com/Isabellopezmunoz/workshop-claude"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Repositorio en GitHub"
        class="inline-flex size-10 items-center justify-center border border-border-base bg-bg-raised text-text-secondary hover:border-accent hover:text-accent transition"
      >
        <Icon name="lucide:github" class="size-5" />
      </a>
    </nav>
  </div>
</header>
